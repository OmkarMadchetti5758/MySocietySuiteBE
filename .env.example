# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MASTER_DB_NAME=mysociety_master
OPERATIONS_DB_NAME=mysociety_operations

# JWT Authentication
# Generate a secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes in ms
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# SMTP Configuration for Emails (Gmail)
# Use a 16-character App Password (Google Account → Security → 2-Step Verification → App passwords).
# Quote the value. Port 587 with SMTP_SECURE=false (STARTTLS).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS="xxxx xxxx xxxx xxxx"

# OTP Configuration
OTP_EXPIRES_IN_MINUTES=10

# S3 / DigitalOcean Spaces
# Objects are stored under amenities/, notices/, festivals/, helpdesk/, society/, parking/
# Enable public file access on the Space (or use the CDN) so <img> tags can load URLs.
DO_SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com
DO_SPACE_REGION=sgp1
DO_SPACE_BUCKET=your_space_name
DO_SPACES_KEY=your_spaces_access_key
DO_SPACES_SECRET=your_spaces_secret
# Optional CDN origin, e.g. https://your_space_name.sgp1.cdn.digitaloceanspaces.com
# DO_SPACES_CDN=
